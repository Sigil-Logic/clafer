defaultScope(1);
intRange(-8, 7);
stringLength(16);

c0_negOne = Clafer("c0_negOne").withCard(1, 1);
c0_five = Clafer("c0_five").withCard(1, 1);
c0_six = Clafer("c0_six").withCard(1, 1);
c0_truncQuot = Clafer("c0_truncQuot").withCard(1, 1);
c0_truncRem = Clafer("c0_truncRem").withCard(1, 1);
c0_nested = Clafer("c0_nested").withCard(1, 1);
c0_inSet = Clafer("c0_inSet").withCard(1, 1);
c0_negOne.refToUnique(Int);
c0_negOne.addConstraint($in(joinRef($this()), constant(-1)));
assert(equal(joinRef(global(c0_negOne)), sub(constant(1), constant(2))));
c0_five.refToUnique(Int);
c0_five.addConstraint($in(joinRef($this()), constant(5)));
assert(equal(joinRef(global(c0_five)), add(constant(2), constant(3))));
c0_six.refToUnique(Int);
c0_six.addConstraint($in(joinRef($this()), constant(6)));
assert(equal(joinRef(global(c0_six)), mul(constant(2), constant(3))));
c0_truncQuot.refToUnique(Int);
c0_truncQuot.addConstraint($in(joinRef($this()), constant(-3)));
assert(equal(joinRef(global(c0_truncQuot)), div(constant(-7), constant(2))));
assert(equal(joinRef(global(c0_truncQuot)), constant(-3)));
c0_truncRem.refToUnique(Int);
c0_truncRem.addConstraint($in(joinRef($this()), constant(-1)));
assert(equal(joinRef(global(c0_truncRem)), mod(constant(-7), constant(2))));
assert(equal(joinRef(global(c0_truncRem)), constant(-1)));
c0_nested.refToUnique(Int);
c0_nested.addConstraint($in(joinRef($this()), constant(3)));
assert(equal(joinRef(global(c0_nested)), constant(3)));
c0_inSet.refToUnique(Int);
c0_inSet.addConstraint($in(joinRef($this()), union(constant(-1), constant(5))));
assert(or(equal(joinRef(global(c0_inSet)), constant(-1)), equal(joinRef(global(c0_inSet)), constant(5))));
