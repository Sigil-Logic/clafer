open util/integer
pred show {}
run show for 1

one sig c0_prod
{ c0_prod_ref : one Int }

fact { (c0_prod.@c0_prod_ref) = ((1.minus[2]).mul[3]) }
assert assertOnLine_20 { (c0_prod.@c0_prod_ref) = (-1.mul[3]) }
check assertOnLine_20 for 1

one sig c0_rightNested
{ c0_rightNested_ref : one Int }

fact { (c0_rightNested.@c0_rightNested_ref) = (1.minus[(2.minus[3])]) }
assert assertOnLine_24 { (c0_rightNested.@c0_rightNested_ref) = 2 }
check assertOnLine_24 for 1

one sig c0_leftNested
{ c0_leftNested_ref : one Int }

fact { (c0_leftNested.@c0_leftNested_ref) = ((1.minus[2]).minus[3]) }
assert assertOnLine_28 { (c0_leftNested.@c0_leftNested_ref) = (-1.mul[4]) }
check assertOnLine_28 for 1

one sig c0_negatedSum
{ c0_negatedSum_ref : one Int }

fact { (c0_negatedSum.@c0_negatedSum_ref) = (-1.mul[(2.plus[1])]) }
assert assertOnLine_33 { (c0_negatedSum.@c0_negatedSum_ref) = (-1.mul[3]) }
check assertOnLine_33 for 1

one sig c0_negatedQuotient
{ c0_negatedQuotient_ref : one Int }

fact { (c0_negatedQuotient.@c0_negatedQuotient_ref) = ((-1.mul[(4.plus[2])]).div[3]) }
assert assertOnLine_37 { (c0_negatedQuotient.@c0_negatedQuotient_ref) = (-1.mul[2]) }
check assertOnLine_37 for 1

one sig c0_setDiff
{ c0_setDiff_ref : one (-1 + 1) - 1 }

assert assertOnLine_43 { (c0_setDiff.@c0_setDiff_ref) = (-1.mul[1]) }
check assertOnLine_43 for 1

one sig c0_flag
{ c0_flag_ref : one Int }

fact { (((c0_flag.@c0_flag_ref) = 1) || ((c0_flag.@c0_flag_ref) = 2)) && ((c0_flag.@c0_flag_ref) != 2) }
fact { !(((c0_flag.@c0_flag_ref) = 3) && ((c0_flag.@c0_flag_ref) = 4)) }
fact { !((c0_flag.@c0_flag_ref) = 4) }
fact { ((c0_flag.@c0_flag_ref) = 1) => (((c0_flag.@c0_flag_ref) = 2) => ((c0_flag.@c0_flag_ref) = 3)) }
assert assertOnLine_53 { (c0_flag.@c0_flag_ref) = 1 }
check assertOnLine_53 for 1

fact { ((c0_prod.@c0_prod_ref).plus[(c0_rightNested.@c0_rightNested_ref)]) = (-1.mul[1]) }
