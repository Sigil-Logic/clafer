scope({c0_N:3});
defaultScope(1);
intRange(-8, 7);
stringLength(16);

c0_N = Abstract("c0_N");
c0_n1 = Clafer("c0_n1").withCard(1, 1);
c0_n2 = Clafer("c0_n2").withCard(1, 1);
c0_n3 = Clafer("c0_n3").withCard(1, 1);
c0_m = Clafer("c0_m").withCard(1, 1);
c0_unionSum = Clafer("c0_unionSum").withCard(1, 1);
c0_restSum = Clafer("c0_restSum").withCard(1, 1);
c0_commonSum = Clafer("c0_commonSum").withCard(1, 1);
c0_nestedSum = Clafer("c0_nestedSum").withCard(1, 1);
c0_mixedSum = Clafer("c0_mixedSum").withCard(1, 1);
c0_N.refTo(Int);
c0_n1.extending(c0_N);
Constraint(implies(some(global(c0_n1)), equal(joinRef(global(c0_n1)), constant(3))));
c0_n2.extending(c0_N);
Constraint(implies(some(global(c0_n2)), equal(joinRef(global(c0_n2)), constant(1))));
c0_n3.extending(c0_N);
Constraint(implies(some(global(c0_n3)), equal(joinRef(global(c0_n3)), constant(2))));
c0_m.refToUnique(Int);
Constraint(implies(some(global(c0_m)), equal(joinRef(global(c0_m)), constant(1))));
c0_unionSum.refToUnique(Int);
Constraint(equal(joinRef(global(c0_unionSum)), add(sum(global(c0_n1)), sum(global(c0_m)))));
assert(equal(joinRef(global(c0_unionSum)), constant(4)));
c0_restSum.refToUnique(Int);
Constraint(equal(joinRef(global(c0_restSum)), sum(diff(global(c0_N), global(c0_n1)))));
assert(equal(joinRef(global(c0_restSum)), constant(3)));
c0_commonSum.refToUnique(Int);
Constraint(equal(joinRef(global(c0_commonSum)), sum(inter(global(c0_N), global(c0_n1)))));
assert(equal(joinRef(global(c0_commonSum)), constant(3)));
c0_nestedSum.refToUnique(Int);
Constraint(equal(joinRef(global(c0_nestedSum)), sum(diff(union(global(c0_n1), global(c0_n2)), global(c0_n1)))));
assert(equal(joinRef(global(c0_nestedSum)), constant(1)));
c0_mixedSum.refToUnique(Int);
Constraint(equal(joinRef(global(c0_mixedSum)), add(sum(union(global(c0_n1), global(c0_n2))), sum(global(c0_m)))));
assert(equal(joinRef(global(c0_mixedSum)), constant(5)));
