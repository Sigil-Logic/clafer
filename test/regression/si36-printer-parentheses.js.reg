defaultScope(1);
intRange(-8, 7);
stringLength(16);

c0_prod = Clafer("c0_prod").withCard(1, 1);
c0_rightNested = Clafer("c0_rightNested").withCard(1, 1);
c0_leftNested = Clafer("c0_leftNested").withCard(1, 1);
c0_negatedSum = Clafer("c0_negatedSum").withCard(1, 1);
c0_negatedQuotient = Clafer("c0_negatedQuotient").withCard(1, 1);
c0_setDiff = Clafer("c0_setDiff").withCard(1, 1);
c0_flag = Clafer("c0_flag").withCard(1, 1);
c0_prod.refToUnique(Int);
Constraint(equal(joinRef(global(c0_prod)), mul(sub(constant(1), constant(2)), constant(3))));
assert(equal(joinRef(global(c0_prod)), constant(-3)));
c0_rightNested.refToUnique(Int);
Constraint(equal(joinRef(global(c0_rightNested)), sub(constant(1), sub(constant(2), constant(3)))));
assert(equal(joinRef(global(c0_rightNested)), constant(2)));
c0_leftNested.refToUnique(Int);
Constraint(equal(joinRef(global(c0_leftNested)), sub(sub(constant(1), constant(2)), constant(3))));
assert(equal(joinRef(global(c0_leftNested)), constant(-4)));
c0_negatedSum.refToUnique(Int);
Constraint(equal(joinRef(global(c0_negatedSum)), minus(add(constant(2), constant(1)))));
assert(equal(joinRef(global(c0_negatedSum)), constant(-3)));
c0_negatedQuotient.refToUnique(Int);
Constraint(equal(joinRef(global(c0_negatedQuotient)), div(minus(add(constant(4), constant(2))), constant(3))));
assert(equal(joinRef(global(c0_negatedQuotient)), constant(-2)));
c0_setDiff.refToUnique(Int);
c0_setDiff.addConstraint($in(joinRef($this()), diff(union(constant(-1), constant(1)), constant(1))));
assert(equal(joinRef(global(c0_setDiff)), constant(-1)));
c0_flag.refToUnique(Int);
Constraint(and(or(equal(joinRef(global(c0_flag)), constant(1)), equal(joinRef(global(c0_flag)), constant(2))), notEqual(joinRef(global(c0_flag)), constant(2))));
Constraint(not(and(equal(joinRef(global(c0_flag)), constant(3)), equal(joinRef(global(c0_flag)), constant(4)))));
Constraint(not(equal(joinRef(global(c0_flag)), constant(4))));
Constraint(implies(equal(joinRef(global(c0_flag)), constant(1)), implies(equal(joinRef(global(c0_flag)), constant(2)), equal(joinRef(global(c0_flag)), constant(3)))));
assert(equal(joinRef(global(c0_flag)), constant(1)));
Constraint(equal(add(joinRef(global(c0_prod)), joinRef(global(c0_rightNested))), constant(-1)));
