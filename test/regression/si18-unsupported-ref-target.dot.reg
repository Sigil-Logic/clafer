digraph "si18-unsupported-ref-target"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"c0_Person" [label="abstract Person" URL="#c0_Person" tooltip="abstract Person&#10;"];
"c0_Alice" [label="Alice : Person" URL="#c0_Alice" tooltip="Alice : Person&#10;"];
"c0_Alice" -> "c0_Person" [arrowhead=onormal constraint=true weight=100];
"c0_mixed" [label="mixed -&gt; Person++1" URL="#c0_mixed" tooltip="mixed -&gt; Person++1&#10;"];
"c0_mixed" -> "c0_Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
}