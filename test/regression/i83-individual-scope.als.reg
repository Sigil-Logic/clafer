open util/integer
pred show {}
run show for 1 but 2 c0_d, 2 c0_e, 2 c0_f, 4 c0_g

lone sig c0_a
{}

one sig c0_b
{}

some sig c0_c
{}

fact { 2 <= #c0_d }
sig c0_d
{ r_c0_e : lone c0_e
, r_c0_f : one c0_f
, r_c0_g : set c0_g }
{ 2 <= #r_c0_g }

sig c0_e
{}
{ one @r_c0_e.this }

sig c0_f
{}
{ one @r_c0_f.this }

sig c0_g
{}
{ one @r_c0_g.this }

