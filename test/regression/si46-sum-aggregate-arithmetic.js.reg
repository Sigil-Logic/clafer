scope({c0_N:2});
defaultScope(1);
intRange(-8, 7);
stringLength(16);

c0_N = Abstract("c0_N");
c0_n1 = Clafer("c0_n1").withCard(1, 1);
c0_n2 = Clafer("c0_n2").withCard(1, 1);
c0_minusOne = Clafer("c0_minusOne").withCard(1, 1);
c0_plusOne = Clafer("c0_plusOne").withCard(1, 1);
c0_doubled = Clafer("c0_doubled").withCard(1, 1);
c0_total = Clafer("c0_total").withCard(1, 1);
c0_setMinusOne = Clafer("c0_setMinusOne").withCard(1, 1);
c0_N.refTo(Int);
c0_n1.extending(c0_N);
Constraint(implies(some(global(c0_n1)), equal(joinRef(global(c0_n1)), constant(5))));
c0_n2.extending(c0_N);
Constraint(implies(some(global(c0_n2)), equal(joinRef(global(c0_n2)), constant(2))));
c0_minusOne.refToUnique(Int);
Constraint(equal(joinRef(global(c0_minusOne)), sub(sum(global(c0_N)), constant(1))));
assert(equal(joinRef(global(c0_minusOne)), constant(6)));
c0_plusOne.refToUnique(Int);
Constraint(equal(joinRef(global(c0_plusOne)), add(sum(global(c0_N)), constant(1))));
assert(equal(joinRef(global(c0_plusOne)), constant(8)));
c0_doubled.refToUnique(Int);
Constraint(equal(joinRef(global(c0_doubled)), mul(sum(global(c0_N)), constant(2))));
assert(equal(joinRef(global(c0_doubled)), constant(14)));
c0_total.refToUnique(Int);
Constraint(equal(joinRef(global(c0_total)), sum(global(c0_N))));
assert(equal(joinRef(global(c0_total)), constant(7)));
c0_setMinusOne.refToUnique(Int);
Constraint(equal(joinRef(global(c0_setMinusOne)), sub(joinRef(global(c0_N)), constant(1))));
assert(equal(joinRef(global(c0_setMinusOne)), constant(6)));
