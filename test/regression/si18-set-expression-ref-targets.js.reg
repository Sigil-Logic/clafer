scope({c0_Person:2, c0_friend:2});
defaultScope(1);
intRange(-8, 7);
stringLength(16);

c0_Person = Abstract("c0_Person");
c0_Head = c0_Person.addAbstractChild("c0_Head");
c0_Alice = Clafer("c0_Alice").withCard(1, 1);
c1_Head = c0_Alice.addChild("c1_Head").withCard(1, 1);
c0_Ella = Clafer("c0_Ella").withCard(1, 1);
c0_Guest = Clafer("c0_Guest").withCard(1, 1);
c0_friend = Clafer("c0_friend").withCard(2, 2);
c0_onlyAlice = Clafer("c0_onlyAlice").withCard(1, 1);
c0_exceptElla = Clafer("c0_exceptElla").withCard(1, 1);
c0_anyone = Clafer("c0_anyone").withCard(1, 1);
c0_heads = Clafer("c0_heads").withCard(1, 1);
c0_grade = Clafer("c0_grade").withCard(1, 1);
c0_nonZero = Clafer("c0_nonZero").withCard(1, 1);
c0_single = Clafer("c0_single").withCard(1, 1);
c0_notZeroOrOne = Clafer("c0_notZeroOrOne").withCard(1, 1);
c0_smallOrAny = Clafer("c0_smallOrAny").withCard(1, 1);
c0_name = Clafer("c0_name").withCard(1, 1);
c0_tag = Clafer("c0_tag").withCard(1, 1);
c0_Alice.extending(c0_Person);
c1_Head.extending(c0_Head);
c0_Ella.extending(c0_Person);
c0_friend.refToUnique(c0_Person);
c0_friend.addConstraint($in(joinRef($this()), union(global(c0_Alice), global(c0_Ella))));
c0_onlyAlice.refToUnique(c0_Person);
c0_onlyAlice.addConstraint($in(joinRef($this()), inter(global(c0_Alice), global(c0_Person))));
c0_exceptElla.refToUnique(c0_Person);
c0_exceptElla.addConstraint($in(joinRef($this()), diff(global(c0_Person), global(c0_Ella))));
c0_anyone.refToUnique(rc.getModel().getTypeRoot());
c0_anyone.addConstraint($in(joinRef($this()), union(global(c0_Person), global(c0_Guest))));
c0_heads.refToUnique(c0_Head);
c0_grade.refToUnique(Int);
c0_grade.addConstraint($in(joinRef($this()), union(union(constant(1), constant(2)), constant(3))));
c0_nonZero.refToUnique(Int);
c0_nonZero.addConstraint(notIn(joinRef($this()), constant(0)));
c0_single.refToUnique(Int);
c0_single.addConstraint($in(joinRef($this()), constant(1)));
c0_notZeroOrOne.refToUnique(Int);
c0_notZeroOrOne.addConstraint(notIn(joinRef($this()), union(constant(0), constant(1))));
c0_smallOrAny.refToUnique(Int);
c0_smallOrAny.addConstraint($in(joinRef($this()), union(constant(1), constant(2))));
c0_name.refToUnique(string);
c0_name.addConstraint(equal(joinRef($this()), constant("\"Alice\"")));
c0_tag.refToUnique(string);
c0_tag.addConstraint(or(equal(joinRef($this()), constant("\"a\"")), equal(joinRef($this()), constant("\"b\""))));
assert(and($in(global(c0_Alice), joinRef(global(c0_friend))), $in(global(c0_Ella), joinRef(global(c0_friend)))));
assert(equal(joinRef(global(c0_onlyAlice)), global(c0_Alice)));
assert(equal(joinRef(global(c0_exceptElla)), global(c0_Alice)));
assert($in(joinRef(global(c0_anyone)), union(global(c0_Person), global(c0_Guest))));
assert(and(greaterThanEqual(joinRef(global(c0_grade)), constant(1)), lessThanEqual(joinRef(global(c0_grade)), constant(3))));
assert(notEqual(joinRef(global(c0_nonZero)), constant(0)));
assert(equal(joinRef(global(c0_single)), constant(1)));
assert(and(notEqual(joinRef(global(c0_notZeroOrOne)), constant(0)), notEqual(joinRef(global(c0_notZeroOrOne)), constant(1))));
assert(or(equal(joinRef(global(c0_smallOrAny)), constant(1)), equal(joinRef(global(c0_smallOrAny)), constant(2))));
assert(equal(joinRef(global(c0_name)), constant("\"Alice\"")));
assert(or(equal(joinRef(global(c0_tag)), constant("\"a\"")), equal(joinRef(global(c0_tag)), constant("\"b\""))));
