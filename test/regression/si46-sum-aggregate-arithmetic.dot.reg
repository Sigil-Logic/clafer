"c0_n1" -> "c0_N" [arrowhead=onormal constraint=true weight=100];
"c0_n2" [label="n2 : N = 2" URL="#c0_n2" tooltip="n2 : N = 2&#10;"];
"c0_n2" -> "c0_N" [arrowhead=onormal constraint=true weight=100];
"c0_minusOne" [label="minusOne -&gt; integer" URL="#c0_minusOne" tooltip="minusOne -&gt; integer&#10;"];
"c0_plusOne" [label="plusOne -&gt; integer" URL="#c0_plusOne" tooltip="plusOne -&gt; integer&#10;"];
"c0_doubled" [label="doubled -&gt; integer" URL="#c0_doubled" tooltip="doubled -&gt; integer&#10;"];
"c0_total" [label="total -&gt; integer" URL="#c0_total" tooltip="total -&gt; integer&#10;"];
"c0_setMinusOne" [label="setMinusOne -&gt; integer" URL="#c0_setMinusOne" tooltip="setMinusOne -&gt; integer&#10;"];
}