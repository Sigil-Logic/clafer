digraph "si33-literal-arithmetic-ref-target"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"c0_negOne" [label="negOne -&gt; (1 - 2)" URL="#c0_negOne" tooltip="negOne -&gt; (1 - 2)&#10;"];
"c0_five" [label="five -&gt; (2 + 3)" URL="#c0_five" tooltip="five -&gt; (2 + 3)&#10;"];
"c0_six" [label="six -&gt; (2 * 3)" URL="#c0_six" tooltip="six -&gt; (2 * 3)&#10;"];
"c0_truncQuot" [label="truncQuot -&gt; (-7 / 2)" URL="#c0_truncQuot" tooltip="truncQuot -&gt; (-7 / 2)&#10;"];
"c0_truncRem" [label="truncRem -&gt; (-7 % 2)" URL="#c0_truncRem" tooltip="truncRem -&gt; (-7 % 2)&#10;"];
"c0_nested" [label="nested -&gt; ((1 - 2) * -(2 + 1))" URL="#c0_nested" tooltip="nested -&gt; ((1 - 2) * -(2 + 1))&#10;"];
"c0_inSet" [label="inSet -&gt; (1 - 2)++(2 + 3)" URL="#c0_inSet" tooltip="inSet -&gt; (1 - 2)++(2 + 3)&#10;"];
}